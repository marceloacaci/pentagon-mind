{
  "$schema": "https://html-validate.org/schemas/config.json",

  "extends": ["html-validate:recommended"],

  "rules": {
    "void-style": ["error", { "style": "selfclosing" }],

    "element-required-attributes": "off",

    "prefer-tbody": "off",

    "no-inline-style": ["error", { "include": ["display"] }],

    "attribute-boolean-style": "off",

    "no-implicit-button-type": "error",

    "wcag/h30": "error",
    "wcag/h32": "error",
    "wcag/h36": "error",
    "wcag/h37": "error",
    "wcag/h63": "error",
    "wcag/h67": "error",
    "wcag/h71": "error",

    "require-sri": "off"
  },

  "elements": [
    "html5",
    {
      "img": {
        "attributes": {
          "src": { "required": false }
        }
      }
    }
  ]
}
