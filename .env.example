# Variáveis de ambiente — PENTAGON-MIND
# Copie para .env.local (não versionado) e preencha se for usar proteção real de rate limit.

# Upstash Redis (rate limiting externo na rota /api/contact).
# Se ausentes, o build/local usa um STUB em memória (sem proteção real em produção serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Site URL (usado em metadata/OpenGraph/sitemap)
NEXT_PUBLIC_SITE_URL=https://pentagon-mind.example
